@page "/"
@using Sirkelen.Shared.Services
@using Sirkelen.Shared.Models
@namespace Sirkelen.Shared.Components
@inject FirebaseService FirebaseService
@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager
@inject AppUpdateService UpdateService
@inject IJSRuntime JSRuntime

<script>
function scrollToBottom(element) {
    if (element) {
        element.scrollTop = element.scrollHeight;
    }
}

function initializeChatRoom() {
    const chatInputContainer = document.querySelector('.chat-input-container');
    const chatMessages = document.querySelector('.chat-messages');
}
</script>
<UpdateNotification />
<ScrollView>
<div class="chatroom-container">
    <div class="chat-messages" @ref="chatMessagesRef">
        @if (messages == null)
        {
            <div class="message">Loading messages...</div>
        }
        else if (messages.Count == 0)
        {
            <div class="message">No messages yet. Start the conversation!</div>
        }
        else
        {
            @foreach (var message in messages)
            {
                bool isSentMessage = message.UserId == AuthService.CurrentUser.Id;
                <div class="message-container @(isSentMessage ? "sent" : "received")">
                    @if (!isSentMessage)
                    {
                        <img src="@GetUserProfilePicture(message.UserId)" alt="Profile" class="profile-picture" />
                    }
                    <div class="message">
                        <div class="message-info">
                            <span class="user-name">@GetUserName(message.UserId)</span>
                            <span class="message-time">@FormatMessageTime(message.Time)</span>
                        </div>
                        <div class="message-content">@message.MessageContent</div>
                    </div>
                    @if (isSentMessage)
                    {
                        <img src="@GetUserProfilePicture(message.UserId)" alt="Profile" class="profile-picture" />
                    }
                </div>
            }
        }
    </div>

    <div class="chat-input-container">
        <input type="text" @bind="newMessageContent" @bind:event="oninput" @onkeyup="HandleKeyPress" class="chat-input" placeholder="Enter your message..." />
        <button @onclick="SendMessage" class="send-button">➤</button>
    </div>
</div>
</ScrollView>

<style>
    .chatroom-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 3.5rem);
        margin: -20px 0 0 0;
    }

    .chat-messages {
        flex-grow: 1;
        overflow-y: auto;
        padding-bottom: 70px;
    }

    .message-container {
        display: flex;
        align-items: flex-start;
        margin-bottom: 10px;
        max-width: 80%;
    }

    .message {
        word-wrap: break-word;
        max-width: calc(100% - 50px);
    }

    .message-content {
        padding: 10px;
        border-radius: 20px;
        word-break: break-word;
    }

    .sent {
        flex-direction: row-reverse;
        margin-left: auto;
    }

    .received {
        margin-right: auto;
        margin-left: 0px;
        align-self: flex-start;
    }

    .sent .message-content {
        background-color: #7fc0ff;
    }

    .received .message-content {
        background-color: #E8E8E8;
    }

    .message-info {
        font-size: 0.8em;
        color: #888;
        margin-bottom: 5px;
    }

    .profile-picture {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        margin: 0 3px;
        flex-shrink: 0;
    }

    .chat-input-container {
        display: flex;
        padding: 10px;
        background-color: white;
        position: sticky;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1000;
    }

    .chat-input {
        flex-grow: 1;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 20px;
    }

    .send-button {
        background-color: #66aff8;
        color: white;
        border: none;
        padding: 10px 20px;
        margin-left: 10px;
        cursor: pointer;
        border-radius: 20px;
    }
</style>

@code {
    private List<Message>? messages;
    private Dictionary<string, string> userNames = new Dictionary<string, string>();
    private Dictionary<string, string> userProfilePictures = new Dictionary<string, string>();
    private string newMessageContent = string.Empty;
    private ElementReference chatMessagesRef;
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadMessages();

        await UpdateService.CheckForUpdates();

        FirebaseService.OnNewMessageReceived += async message =>
        {
            await InvokeAsync(() =>
            {
                if (!messages.Any(m => m.Id == message.Id))
                {
                    messages.Add(message);
                    messages = messages.OrderBy(m => m.Time).ToList();
                    StateHasChanged();
                    _ = ScrollToBottom();
                }
            });
        };

        await FirebaseService.ListenForChatMessages();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeChatRoom");
        }
        await ScrollToBottom();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", chatMessagesRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling to bottom: {ex.Message}");
        }
    }

    private async Task LoadMessages()
    {
        var users = await FirebaseService.GetUsers();
        var distinctUsers = users.GroupBy(u => u.Id).Select(g => g.First()).ToList();
        userNames = distinctUsers.ToDictionary(u => u.Id, u => u.Name);
        userProfilePictures = distinctUsers.ToDictionary(u => u.Id, u => u.ProfilePictureUrl);

        messages = await FirebaseService.GetChatMessages();
        messages = messages.OrderBy(m => m.Time).ToList();
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessageContent))
        {
            var message = new Message
            {
                Id = Guid.NewGuid().ToString(),
                UserId = AuthService.CurrentUser.Id,
                MessageContent = newMessageContent,
                Time = DateTime.UtcNow
            };

            await FirebaseService.AddChatMessage(message);
            newMessageContent = string.Empty;
            await LoadMessages();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private string GetUserName(string userId)
    {
        return userNames.TryGetValue(userId, out var name) ? name : userId;
    }
    
    private string GetUserProfilePicture(string userId)
    {
        return userProfilePictures.TryGetValue(userId, out var pictureUrl) ? pictureUrl : "/images/default-profile-picture.png";
    }

    private DateTime ConvertToOsloTime(DateTime utcTime)
    {
        TimeZoneInfo osloTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Central European Standard Time");
        DateTime osloTime = TimeZoneInfo.ConvertTimeFromUtc(utcTime, osloTimeZone);
        return osloTime;
    }

    private string FormatMessageTime(DateTime messageTime)
    {
        DateTime osloMessageTime = ConvertToOsloTime(messageTime);
        DateTime now = ConvertToOsloTime(DateTime.UtcNow);

        if (osloMessageTime.Date == DateTime.Today.AddDays(-1))
        {
            return $"yesterday {osloMessageTime.ToString("HH:mm")}";
        }
        else if (osloMessageTime.Date <= DateTime.Today.AddDays(-2))
        {
            return $"{osloMessageTime.ToString("dd-MMMM-yyyy")} {osloMessageTime.ToString("HH:mm")}";
        }
        return osloMessageTime.ToString("HH:mm");
    }
}