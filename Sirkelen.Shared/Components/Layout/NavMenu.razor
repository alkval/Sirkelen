@using Sirkelen.Shared.Services
@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="user-profile">@(AuthService.CurrentUser?.Name ?? "Sirkelen")</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weight-tracker">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Track Body Weight
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calorietracker">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Track Calories
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="leaderboard">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Leader Board
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="personal-records">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Personal Records
            </NavLink>
        </div>
         <div class="nav-item px-3">
            <NavLink class="nav-link" href="members">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Members
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }
}