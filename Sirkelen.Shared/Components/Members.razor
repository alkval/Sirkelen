@page "/members"
@using Sirkelen.Shared.Models
@using Sirkelen.Shared.Services
@inject FirebaseService FirebaseService

<h3>Members</h3>

@if (users == null)
{
    <p>Loading...</p>
}
else if (users.Count == 0)
{
    <p>No members found.</p>
}
else
{
    <div>
        @foreach (var user in users)
        {
            <div>
                <img src="@user.ProfilePictureUrl" alt="Profile picture of @user.Name" 
                style="width: 75px; height: 75px; border-radius: 50%; padding-right: 5px;"/>
                <strong>@user.Name</strong> (@user.Height cm,  @user.Weight kg)
            </div>
        }
    </div>
}
<style>
    .profile-picture {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        margin-bottom: 10px;
        object-fit: cover;
    }
</style>
@code {
    private List<User>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await FirebaseService.GetUsers();
    }
}
