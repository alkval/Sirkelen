@page "/members"
@using Sirkelen.Shared.Models
@using Sirkelen.Shared.Services
@inject IUserService UserService

<h3>Members</h3>

@if (members == null)
{
    <p><em>Loading members...</em></p>
}
else if (members.Count == 0)
{
    <p>No members found.</p>
}
else
{
    <ul class="member-list">
        @foreach (var member in members)
        {
            <li class="member-item">
                <img src="@member.ProfilePictureUrl" alt="@member.Name's profile picture" class="profile-picture" />
                <div>
                    <h4>@member.Name</h4>
                    <p>Height: @member.Height m</p>
                    <p>Weight: @member.Weight kg</p>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<User> members;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            members = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            // Handle any exceptions
            Console.WriteLine($"Error fetching members: {ex.Message}");
        }
    }
}
